# Copiar como .env y llenar. El .env nunca se sube a git.
DB_SERVER=agpcolombia.database.windows.net
DB_NAME=AGP_Ingenieria
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server

# Servidor web: 0.0.0.0 = visible para toda la red de AGP
HOST=0.0.0.0
PUERTO=8050
# Si se llena, para escribir metas/capacidad en el tablero se pide esta clave
CLAVE_EDICION=
# Cada cuántos segundos se revisa si algún Excel cambió
SEGUNDOS_REVISION=60

# Rutas de los Excel sincronizados con OneDrive. Si se dejan vacías se buscan solas dentro de OneDrive.
RUTA_CONSOLIDADO=
RUTA_PEDIDOS=
RUTA_X5=
RUTA_FILA_MOLDES=
RUTA_LOGOS=
RUTA_VITROJET=
RUTA_PASTA_PLATA=
RUTA_INDICADORES_DIARIOS=
